# Postgres connection string
DATABASE_URL=postgres://user:password@host:5432/tsdb?sslmode=require

# Brain
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash,gemini-flash-lite-latest,gemini-3.1-flash-lite   # tried in order when the main model is busy or out of quota

# Photon 2.0
PHOTON_API_KEY=
PHOTON_PROJECT_ID=
PHOTON_WEBHOOK_SECRET=        # whsec_... from the Photon dashboard webhook settings
PHOTON_SEND=0                 # 1 = really send texts; 0 = dry run (logged only)
PHOTON_PLATFORM=imessage      # imessage (Photon shared line) or sms (needs a purchased SMS number)
PHOTON_AGENT_USER_ID=         # your agent's User id in Photon (needed to text MANAGER_PHONE first)

# Demo contacts, used for every region (no JOIN texts needed)
MANAGER_PHONE=                # +1..., gets work-order texts, approves, reports problems
SERVICE_WORKER_PHONE=         # +1..., gets the urgent calls

# Phone calls (photon_call.py): Twilio dials, Photon's voice number carries the call over SIP
PHOTON_CALL=0                 # 1 = really place calls; 0 = dry run (logged only)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
PHOTON_VOICE_NUMBER=          # your Photon voice number, E.164 (+1...)
PHOTON_SIP_HOST=              # Photon SIP host:port from the Voice profile
PHOTON_SIP_USERNAME=
PHOTON_SIP_PASSWORD=          # Photon outbound SIP password (shown once)

# API
ADMIN_TOKEN=change-me         # required for actions (sweep, import, approve)
FRONTEND_ORIGIN=http://localhost:3000

# Scheduler (runs inside the API)
SCHEDULER=on
SWEEP_TIME=06:00              # Central time
SCORE_EVERY_MIN=30

# Risk thresholds
RISK_HIGH=0.20
RISK_MEDIUM=0.08
