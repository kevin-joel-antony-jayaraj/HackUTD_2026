# Copy to .env (git-ignored) on the machine/server that runs the pipeline:  cp .env.example .env
# The key stays on the server. Website visitors never need one and never see it.
NVIDIA_API_KEY=
DATABASE_URL=postgres://localhost/sitesignal
# Optional: require "Authorization: Bearer <token>" for uploads/approvals (leave empty for local demos)
ADMIN_TOKEN=
# Optional: comma-separated origins allowed to call the API from a browser (default: all)
FRONTEND_ORIGINS=
# Speed vs. rate limits (defaults shown). Lower them if NVIDIA returns 429 "too many requests".
NEMOTRON_MAX_CONCURRENCY=4      # simultaneous Nemotron calls, across everything
EXTRACT_CONCURRENCY=4           # chunks of one uploaded file read in parallel
DECIDE_SITE_CONCURRENCY=3       # sites decided in parallel (each site uses 2 independent runs)
